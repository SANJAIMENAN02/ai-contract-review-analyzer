# Copy to ".env". Everything is optional: with no values set the app runs fully
# offline (rule-based analysis + local JSON storage).

# --- Frontend -> backend --------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000

# --- Optional AI-enhanced summary (any OpenAI-compatible API) -------------
# Leave OPENAI_API_KEY blank to use the built-in local summarizer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Optional MongoDB (otherwise JSON files in data/contracts/) -----------
MONGO_URI=
MONGO_DB_NAME=contract_analyzer

# --- Optional tuning ------------------------------------------------------
# MAX_FILE_SIZE_MB=10
# DATA_DIR=
# UPLOAD_DIR=
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# API_TIMEOUT_SECONDS=30
